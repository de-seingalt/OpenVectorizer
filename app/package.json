{
  "name": "openvectorizer-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "wasm": "node ../scripts/prebuild.mjs",
    "predev": "node ../scripts/prebuild.mjs --dev",
    "dev": "vite",
    "prebuild": "node ../scripts/prebuild.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json --fail-on-warnings && tsc -p tsconfig.node.json",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "test": "vitest run --dir src",
    "test:e2e": "playwright test",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@internationalized/date": "^3.12.4",
    "@playwright/test": "^1.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.6",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^24.19.2",
    "bits-ui": "^2.22.0",
    "cn": "^0.5.2",
    "eslint": "^10.15.0",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "mode-watcher": "^1.1.0",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn-svelte": "^1.8.2",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "svelte-sonner": "^1.2.3",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.6",
    "vitest": "^5.1.2"
  },
  "dependencies": {
    "@lucide/svelte": "^1.80.0",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1"
  },
  "packageManager": "pnpm@12.23.0"
}
